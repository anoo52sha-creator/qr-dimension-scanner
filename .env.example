# ==========================================
# Backend Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Local development example (do NOT commit real credentials):
# DATABASE_URL=postgresql://postgres:Postgre@localhost:5432/qr_dimensions_db
# Cloud PostgreSQL (Neon / Render) example:
# DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/qr_dimensions_db?sslmode=require
DATABASE_URL=postgresql://postgres:Postgre@localhost:5432/qr_dimensions_db

# Set to 'true' when connecting to cloud PostgreSQL requiring SSL (Neon, Render, etc.)
DATABASE_SSL=false

# Comma-separated allowed CORS origins (use * for mobile Capacitor apps or specify origins)
CORS_ORIGIN=*

# ==========================================
# Frontend Configuration (Vite)
# ==========================================
# Production HTTPS URL of the deployed Render backend (no trailing slash)
VITE_API_BASE_URL=https://qr-dimension-scanner-api.onrender.com
